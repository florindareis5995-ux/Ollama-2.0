{
  "name": "ai-studio",
  "version": "1.0.0",
  "description": "Beautiful desktop interface for Ollama and local AI tools",
  "main": "src/main/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "cross-env BROWSER=none react-scripts start",
    "build": "react-scripts build && electron-builder",
    "electron": "electron .",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": ["ollama", "ai", "chat", "code-generation", "desktop"],
  "author": "AI Studio Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "node-fetch": "^2.7.0",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.10.0",
    "tree-kill": "^1.2.2",
    "node-pty": "^1.0.0",
    "marked": "^9.1.0",
    "highlight.js": "^11.9.0",
    "lucide-react": "^0.294.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "framer-motion": "^10.16.0",
    "zustand": "^4.4.6",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.2",
    "@types/react": "^18.2.39",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.aistudio.app",
    "productName": "AI Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "src/backend/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
